{
  "annotations": {
    "list": []
  },
  "description": "Cross-platform hardware health for Ansible-managed development machines. Missing sensors are shown as N/A rather than zero.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "OFFLINE"
                },
                "1": {
                  "color": "green",
                  "text": "ONLINE"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (instance, os) (max_over_time(up{fleet=\"dev-machines\",instance=~\"$instance\"}[2m]))",
          "instant": true,
          "legendFormat": "{{instance}} · {{os}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Machine status",
      "type": "stat",
      "id": 1
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (instance, os, vendor, model, cpu) (dev_machine_info{fleet=\"dev-machines\",instance=~\"$instance\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Hardware inventory",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "instance": 0,
              "os": 1,
              "vendor": 2,
              "model": 3,
              "cpu": 4
            },
            "renameByName": {
              "cpu": "CPU",
              "instance": "Machine",
              "model": "Model",
              "os": "OS",
              "vendor": "Vendor"
            }
          }
        }
      ],
      "type": "table",
      "id": 2
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 3,
