      "targets": [
        {
          "editorMode": "code",
          "expr": "(1 - avg by (instance) (rate(node_cpu_seconds_total{fleet=\"dev-machines\",instance=~\"$instance\",mode=\"idle\"}[5m]))) or (1 - avg by (instance) (rate(windows_cpu_time_total{fleet=\"dev-machines\",instance=~\"$instance\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CPU utilization",
      "type": "timeseries",
      "id": 4
