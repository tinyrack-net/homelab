{
  "annotations": {"list": []},
  "description": "RED metrics and service dependencies generated from all incoming spans before tail sampling.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {"asDropdown": false, "icon": "external link", "includeVars": true, "keepTime": true, "tags": [], "targetBlank": false, "title": "Explore traces", "type": "link", "url": "/explore?schemaVersion=1&panes=%7B%22trace%22:%7B%22datasource%22:%22VictoriaTraces%22,%22queries%22:%5B%7B%22queryType%22:%22search%22,%22refId%22:%22A%22%7D%5D%7D"}
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[$__rate_interval]))", "legendFormat": "{{service_name}}", "range": true, "refId": "A"}],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "100 * sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / clamp_min(sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{service_name}}", "range": true, "refId": "A"}],
      "title": "Error rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le, service_name) (rate(traces_span_metrics_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))", "legendFormat": "p50 {{service_name}}", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_span_metrics_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))", "legendFormat": "p95 {{service_name}}", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(traces_span_metrics_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))", "legendFormat": "p99 {{service_name}}", "range": true, "refId": "C"}
      ],
      "title": "Request latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 8},
      "id": 4,
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false}, "showHeader": true},
      "targets": [{"editorMode": "code", "expr": "sum by (client, server) (rate(traces_service_graph_request_total[$__rate_interval]))", "format": "table", "instant": true, "legendFormat": "{{client}} → {{server}}", "refId": "A"}],
      "title": "Service dependencies",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {"client": 0, "server": 1, "Value": 2}, "renameByName": {"Value": "requests/s", "client": "client", "server": "server"}}}],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["traces", "opentelemetry"],
  "templating": {"list": [{"allValue": ".*", "current": {"text": "All", "value": "$__all"}, "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"}, "definition": "label_values(traces_span_metrics_calls_total, service_name)", "includeAll": true, "label": "Service", "name": "service", "query": {"query": "label_values(traces_span_metrics_calls_total, service_name)", "refId": "StandardVariableQuery"}, "refresh": 2, "sort": 1, "type": "query"}]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Trace Overview",
  "uid": "trace-overview",
  "version": 1
}
