{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "count(count by (cluster) (up{cluster=~\"$cluster\"}))", "refId": "A"}],
      "title": "Reporting clusters",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(kube_node_status_condition{cluster=~\"$cluster\",condition=\"Ready\",status=\"true\"})", "refId": "A"}],
      "title": "Ready nodes",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "targets": [{"expr": "sum(kube_pod_status_phase{cluster=~\"$cluster\",phase=\"Running\"})", "refId": "A"}],
      "title": "Running pods",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}}},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "targets": [{"expr": "sum(kube_pod_container_status_waiting_reason{cluster=~\"$cluster\",reason=~\"CrashLoopBackOff|ImagePullBackOff|ErrImagePull\"})", "refId": "A"}],
      "title": "Failed containers",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5},
      "id": 5,
      "targets": [{"expr": "1 - avg by (cluster, instance) (rate(node_cpu_seconds_total{cluster=~\"$cluster\",mode=\"idle\"}[5m]))", "legendFormat": "{{cluster}} / {{instance}}", "refId": "A"}],
      "title": "Node CPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "targets": [{"expr": "1 - (node_memory_MemAvailable_bytes{cluster=~\"$cluster\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\"})", "legendFormat": "{{cluster}} / {{instance}}", "refId": "A"}],
      "title": "Node memory utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}},
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 14},
      "id": 7,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "sum(up{cluster=~\"$cluster\",job=\"alloy\"})", "refId": "A"}],
      "title": "Healthy Alloy collectors",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 14},
      "id": 8,
      "targets": [{"expr": "sum by (cluster) (increase(prometheus_remote_storage_samples_failed_total{cluster=~\"$cluster\"}[10m]))", "legendFormat": "{{cluster}}", "refId": "A"}],
      "title": "Remote-write failures (10m)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["homelab", "fleet"],
  "templating": {"list": [{"allValue": ".*", "current": {"text": "All", "value": "$__all"}, "datasource": {"type": "prometheus", "uid": "VictoriaMetrics"}, "definition": "label_values(up, cluster)", "includeAll": true, "label": "Cluster", "name": "cluster", "query": {"query": "label_values(up, cluster)", "refId": "StandardVariableQuery"}, "refresh": 1, "type": "query"}]},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Fleet Overview",
  "uid": "homelab-fleet-overview",
  "version": 1
}