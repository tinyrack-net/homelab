# Internal-only: served at tables.intranet.winetree94.com by internal Traefik.
ALLOWED_HOSTS=tables.intranet.winetree94.com
# Internal (Django) database. User databases such as personal-data are
# connected from the web UI ("Connect Database").
POSTGRES_HOST=mathesar-database-cluster-rw.mathesar-system.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=mathesar_django
POSTGRES_USER=mathesar
POSTGRES_SSLMODE=disable
WEB_CONCURRENCY=3
# Sign-in only through Issuary (verified on 2026-10-28: the Issuary login
# links to the local admin 'me' by email). Administrators can still reset
# passwords as a break-glass path.
REQUIRE_SSO_LOGIN=true
MATHESAR_INSTANCE_NAME=Personal Tables
