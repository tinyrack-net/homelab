NODE_ENV=production
PORT=3000
TZ=Asia/Seoul
# Public URL, also used for Kobo sync endpoints and email links.
APP_URL=https://books.winetree94.com
# The entrypoint builds DATABASE_URL from these and POSTGRES_PASSWORD.
POSTGRES_HOST=bookorbit-database-cluster-rw.bookorbit-system.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=bookorbit
POSTGRES_USER=bookorbit
# The entrypoint starts as root, fixes /data ownership, then drops to this UID.
PUID=1000
PGID=1000
# Heap is sized from the container memory limit.
NODE_MAX_OLD_SPACE_SIZE=auto
# Library folders live on the JuiceFS volume mounted at /books.
LIBRARY_BROWSE_ROOT=/books
# auth.winetree94.com (Issuary) resolves to the private traefik-external LB
# from inside the cluster; BookOrbit rejects private issuers unless enabled.
OIDC_ALLOW_LOCAL_ISSUERS=true
# Sign in only through Issuary. BookOrbit refuses to start unless an active
# superuser is linked to an enabled OIDC provider (winetree94 is). OPDS,
# KOReader and Kobo keep their own per-device credentials. Break-glass: set
# false and restart to use the local password again.
DISABLE_LOCAL_AUTH=true
LOG_LEVEL=info
