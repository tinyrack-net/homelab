KARAKEEP_VERSION=release
NEXTAUTH_URL=https://bookmarks.winetree94.com
OPENAI_BASE_URL=https://openrouter.ai/api/v1
CRAWLER_FULL_PAGE_SCREENSHOT=true
CRAWLER_FULL_PAGE_ARCHIVE=true
# DISABLE_SIGNUPS=true
DISABLE_PASSWORD_AUTH=true
OAUTH_PROVIDER_NAME=Issuary
OAUTH_ALLOW_DANGEROUS_EMAIL_ACCOUNT_LINKING=true
OAUTH_WELLKNOWN_URL=https://auth.winetree94.com/oauth/.well-known/openid-configuration
OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://monitoring-trace-sampler.monitoring-system.svc.cluster.local:4318/v1/traces
OTEL_SERVICE_NAME=karakeep
OTEL_SAMPLE_RATE=1.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,service.version=0.33.2
OTEL_SDK_DISABLED=false
