NODE_ENV=production
URL=https://notes.winetree94.com
PORT=3000
# Traefik terminates TLS; the pod only serves plain HTTP.
FORCE_HTTPS=false
WEB_CONCURRENCY=1
DEFAULT_LANGUAGE=ko_KR
LOG_LEVEL=info
ENABLE_UPDATES=false
PGSSLMODE=disable
# Attachments go through Outline itself onto the JuiceFS volume (Garage-backed).
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
# Cloudflare Tunnel caps request bodies at 100 MB.
FILE_STORAGE_UPLOAD_MAX_SIZE=100000000
FILE_STORAGE_IMPORT_MAX_SIZE=100000000
FILE_STORAGE_WORKSPACE_IMPORT_MAX_SIZE=100000000
# Issuary OIDC. The issuer's discovery document lives under /oauth, so the
# endpoints are listed explicitly instead of using OIDC_ISSUER_URL.
OIDC_CLIENT_ID=outline
OIDC_AUTH_URI=https://auth.winetree94.com/oauth/authorize
OIDC_TOKEN_URI=https://auth.winetree94.com/oauth/token
OIDC_USERINFO_URI=https://auth.winetree94.com/oauth/userinfo
OIDC_LOGOUT_URI=https://auth.winetree94.com/oauth/end_session
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=Issuary
# offline_access is required for Issuary to issue a refresh token; without it
# Outline signs users out when the 1h access token expires.
OIDC_SCOPES=openid profile email offline_access
# auth.winetree94.com resolves to the private traefik-external LB from inside
# the cluster; Outline blocks private targets unless they are listed here.
ALLOWED_PRIVATE_IP_ADDRESSES=10.132.246.2
SMTP_HOST=mail.winetree94.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=notify@winetree94.com
SMTP_FROM_EMAIL=Outline <notify@winetree94.com>
SMTP_REPLY_EMAIL=notify@winetree94.com
# Disabled on purpose so API-driven migrations and automation are not throttled.
RATE_LIMITER_ENABLED=false
