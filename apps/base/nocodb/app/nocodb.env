NC_PUBLIC_URL=https://tables.winetree94.com
# Only the admin (created from NC_ADMIN_EMAIL/NC_ADMIN_PASSWORD) and invited
# users can sign up. SSO is an Enterprise-only feature.
NC_INVITE_ONLY_SIGNUP=true
NC_ADMIN_EMAIL=me@winetree94.com
NC_DISABLE_TELE=true
NC_DISABLE_ERR_REPORTS=true
NC_DISABLE_SUPPORT_CHAT=true
# Traefik terminates TLS in front of the pod.
NC_TRUST_PROXY=1
# Cloudflare Tunnel caps request bodies at 100 MB.
NC_ATTACHMENT_FIELD_SIZE=100000000
# Attachments stay on the local data directory (a Garage-backed JuiceFS
# volume). Never set NC_S3_*; see ../storage/nocodb.storage.yaml.
# Invitation and password-reset mail through notify@ (app password "nocodb").
NC_SMTP_HOST=mail.winetree94.com
NC_SMTP_PORT=587
NC_SMTP_SECURE=false
NC_SMTP_USERNAME=notify@winetree94.com
NC_SMTP_FROM=NocoDB <notify@winetree94.com>
TZ=Asia/Seoul
