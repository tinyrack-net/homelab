---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ restore_sealed_secrets_key_namespace }}
{% for key in restore_sealed_secrets_key_keys %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ key.name }}
  namespace: {{ restore_sealed_secrets_key_namespace }}
  labels:
    sealedsecrets.bitnami.com/sealed-secrets-key: active
type: kubernetes.io/tls
data:
  tls.crt: {{ key.tls_crt | b64encode }}
  tls.key: {{ key.tls_key | b64encode }}
{% endfor %}
